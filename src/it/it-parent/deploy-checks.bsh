// Checks shared by the deploy-scope ITs.  A verify script loads them with
//   source(new File(basedir, "../it-parent/deploy-checks.bsh").getPath());

import java.io.File;
import java.nio.file.Files;

// The build failed with the message and deployed nothing to the
// repositories, which are directories under target
void failedBeforeDeploying(File basedir, String message, String[] repositories) {
  String log = new String(Files.readAllBytes(new File(basedir, "build.log").toPath()));
  if (log.indexOf(message) < 0) {
    throw new RuntimeException("The build didn't fail with: " + message);
  }
  for (int i = 0; i < repositories.length; i++) {
    if (new File(basedir, "target/" + repositories[i]).exists()) {
      throw new RuntimeException("Deployed to target/" + repositories[i] + " although the build should have stopped first");
    }
  }
}

void failedBeforeDeploying(File basedir, String message) {
  failedBeforeDeploying(basedir, message, new String[] { "repo" });
}

// Nothing was deployed to target/repo
void deployedNothing(File basedir, String why) {
  if (new File(basedir, "target/repo").exists()) {
    throw new RuntimeException("Deployed although " + why);
  }
}

// Only the AOL-specific shared NAR (with its checksums and the metadata) was
// deployed to target/repo, not the pom, the main artifact or the noarch NAR
void deployedOnlyAolNar(File basedir, String artifactId) {
  File dir = new File(basedir, "target/repo/com/github/maven-nar/its/nar/" + artifactId + "/1.0-SNAPSHOT");
  String[] files = dir.list();
  if (files == null) {
    throw new RuntimeException("Nothing deployed to " + dir);
  }
  int nars = 0;
  for (int i = 0; i < files.length; i++) {
    String name = files[i];
    if (name.indexOf("-shared.nar") >= 0) {
      // the NAR itself, not its .md5 or .sha1
      if (name.endsWith(".nar")) {
        nars++;
      }
    } else if (!name.startsWith("maven-metadata")) {
      throw new RuntimeException("Deployed " + name + ", which isn't AOL-specific");
    }
  }
  if (nars != 1) {
    throw new RuntimeException("Expected one AOL-specific NAR in " + java.util.Arrays.asList(files));
  }
}
