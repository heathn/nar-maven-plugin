import java.io.File;
import java.util.Enumeration;
import java.util.zip.ZipEntry;
import java.util.zip.ZipFile;

// Only the AOL-specific NAR is deployed, not the pom, the main artifact or
// the noarch NAR.
File dir = new File(basedir, "target/repo/com/github/maven-nar/its/nar/it0045-deploy-scope/1.0-SNAPSHOT");
String[] files = dir.list();
if (files == null) {
  throw new RuntimeException("Nothing deployed to " + dir);
}
int aol = 0;
for (int i = 0; i < files.length; i++) {
  String name = files[i];
  if (name.indexOf("-shared.nar") >= 0) {
    if (name.endsWith(".nar")) {
      aol++;
    }
  } else if (!name.startsWith("maven-metadata")) {
    throw new RuntimeException("Deployed " + name + ", which isn't AOL-specific");
  }
}
if (aol != 1) {
  throw new RuntimeException("Expected one AOL-specific NAR in " + java.util.Arrays.asList(files));
}

// The NARs are built with project.build.outputTimestamp.  A zip entry
// keeps the time as the wall clock, in UTC here.
java.time.LocalDateTime expected = java.time.LocalDateTime.of(2026, 10, 18, 12, 0);
File[] nars = new File(basedir, "target").listFiles();
int checked = 0;
for (int i = 0; i < nars.length; i++) {
  if (!nars[i].getName().endsWith(".nar")) {
    continue;
  }
  ZipFile zip = new ZipFile(nars[i]);
  for (Enumeration e = zip.entries(); e.hasMoreElements();) {
    ZipEntry entry = (ZipEntry) e.nextElement();
    long seconds = java.time.Duration.between(expected, entry.getTimeLocal()).getSeconds();
    if (Math.abs(seconds) > 2) {
      throw new RuntimeException(nars[i].getName() + "!" + entry.getName() + " has time " + entry.getTimeLocal());
    }
    if (entry.getName().endsWith("nar.properties")) {
      String text = new String(zip.getInputStream(entry).readAllBytes(), "ISO-8859-1");
      if (text.startsWith("#")) {
        throw new RuntimeException(entry.getName() + " still has a timestamp comment: " + text);
      }
    }
  }
  zip.close();
  checked++;
}
if (checked < 2) {
  throw new RuntimeException("Expected the noarch and shared NARs, checked " + checked);
}
return true;
