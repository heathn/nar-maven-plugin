import java.io.File;
import java.io.FileInputStream;
import java.util.Properties;

Properties main = new Properties();
main.load(new FileInputStream(new File(basedir,
    "target/classes/META-INF/nar/com.github.maven-nar.its.nar/it0058-mixed-types/nar.properties")));

// the AOL built here, from its shared NAR's directory
String prefix = "it0058-mixed-types-1.0-SNAPSHOT-";
String aol = null;
File[] dirs = new File(basedir, "target/nar").listFiles();
for (int i = 0; i < dirs.length; i++) {
  String name = dirs[i].getName();
  if (dirs[i].isDirectory() && name.startsWith(prefix) && name.endsWith("-shared")) {
    aol = name.substring(prefix.length(), name.length() - "-shared".length());
  }
}
if (aol == null) {
  throw new RuntimeException("No shared NAR directory in target/nar");
}

String[][] expected = {
  { aol + ".libs.binding", "shared" },
  { "libs.binding", "shared" },
  // the library's name, not the executable's
  { aol + ".output", "it0058-mixed-types-1.0-SNAPSHOT" },
};
for (int i = 0; i < expected.length; i++) {
  String value = main.getProperty(expected[i][0]);
  if (!expected[i][1].equals(value)) {
    throw new RuntimeException(expected[i][0] + " is " + value + ", expected " + expected[i][1] + ": " + main);
  }
}

// the second build, without clean, linked the executable under its own
// name, not the library's, and runs it
File bin = new File(basedir, "target/nar/" + prefix + aol + "-executable/bin/" + aol);
// other than cpptasks' history.xml
String[] names = bin.list(new java.io.FilenameFilter() {
  public boolean accept(File dir, String name) {
    return !name.equals("history.xml");
  }
});
java.util.Arrays.sort(names);
if (names.length != 1 || !names[0].startsWith("it0058-mixed-types.") && !names[0].equals("it0058-mixed-types")) {
  throw new RuntimeException("The executables built are " + java.util.Arrays.toString(names)
      + ", expected only it0058-mixed-types");
}
File output = new File(basedir, "target/executable-output.txt");
Object process = new ProcessBuilder(new String[] { new File(bin, names[0]).getPath() })
    .redirectErrorStream(true).redirectOutput(output).start();
// through Process, since BeanShell can't call the JDK's internal subclass
int exit = Process.class.getMethod("waitFor", new Class[0]).invoke(process, new Object[0]).intValue();
String out = new String(java.nio.file.Files.readAllBytes(output.toPath())).trim();
if (exit != 0 || !out.equals("Hello NAR World!")) {
  throw new RuntimeException("The executable printed " + out);
}
return true;
