<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.github.maven-nar.its.nar</groupId>
    <artifactId>it-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../it-parent/pom.xml</relativePath>
  </parent>
  <artifactId>it0065-skip-deployed</artifactId>
  <packaging>nar</packaging>
  <name>Skip deployed: a released version is deployed once</name>
  <version>1.0</version>
  <description>
    With nar.skipDeployed, a build whose artifacts the repository already has
    deploys nothing, with either deploy scope, and one whose repository has
    only some of them fails.
  </description>
  <properties>
    <nar.skipDeployed>true</nar.skipDeployed>
    <!-- outside target, so that the next build's clean keeps it -->
    <altDeploymentRepository>local::file://${project.basedir}/deployed</altDeploymentRepository>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>@project.groupId@</groupId>
        <artifactId>nar-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <libraries>
            <library>
              <type>shared</type>
            </library>
          </libraries>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- the first build starts with an empty repository, even on a retry -->
      <id>fresh</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
              <filesets>
                <fileset>
                  <directory>deployed</directory>
                </fileset>
              </filesets>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- a build for another AOL, deploying only its own NAR -->
      <id>other-primary</id>
      <properties>
        <nar.primaryAol>x86_64-Example-gcc</nar.primaryAol>
      </properties>
    </profile>
    <profile>
      <!-- adds a static NAR, which the repository doesn't have -->
      <id>add-static</id>
      <build>
        <plugins>
          <plugin>
            <groupId>@project.groupId@</groupId>
            <artifactId>nar-maven-plugin</artifactId>
            <configuration>
              <libraries combine.children="append">
                <library>
                  <type>static</type>
                </library>
              </libraries>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
