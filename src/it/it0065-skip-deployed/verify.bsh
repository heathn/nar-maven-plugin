import java.io.File;
import java.nio.file.Files;

File dir = new File(basedir, "deployed/com/github/maven-nar/its/nar/it0065-skip-deployed/1.0");
String[] files = dir.list();
if (files == null || !new File(dir, "it0065-skip-deployed-1.0.pom").exists()) {
  throw new RuntimeException("The first build didn't deploy 1.0 to " + dir);
}
for (int i = 0; i < files.length; i++) {
  if (files[i].indexOf("-static.nar") >= 0) {
    throw new RuntimeException("Deployed " + files[i] + " although 1.0 was already deployed");
  }
}
String log = new String(Files.readAllBytes(new File(basedir, "build.log").toPath()));
String[] expected = {
  // the second build
  "already has com.github.maven-nar.its.nar:it0065-skip-deployed:nar:1.0: skipping its deployment",
  // the third
  "already has this build's AOL-specific artifacts of 1.0",
  // the fourth
  "but not [com.github.maven-nar.its.nar:it0065-skip-deployed:nar:"
};
for (int i = 0; i < expected.length; i++) {
  if (log.indexOf(expected[i]) < 0) {
    throw new RuntimeException("build.log doesn't say: " + expected[i]);
  }
}
return true;
