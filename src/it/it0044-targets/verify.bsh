import java.io.File;
import java.io.FileInputStream;
import java.util.Properties;

Properties main = new Properties();
main.load(new FileInputStream(new File(basedir,
    "target/classes/META-INF/nar/com.github.maven-nar.its.nar/it0044-targets/nar.properties")));

String coordinate = "com.github.maven-nar.its.nar:it0044-targets:nar:";
String[][] expected = {
  { "x86_64-Example-gcc.nar.shared", coordinate + "x86_64-Example-gcc-shared" },
  { "x86_64-Example-gcc.nar.static", coordinate + "x86_64-Example-gcc-static" },
  { "x86_64-Example-gcc.libs.binding", "shared" },
  { "x86_64-Example-gcc.output", "it0044-targets-1.0-SNAPSHOT" },
  { "arm-Other-gcc.nar.shared", coordinate + "arm-Other-gcc-shared" },
  // arm-Other-gcc ships no static library
  { "arm-Other-gcc.nar.static", "" },
  { "arm-Other-gcc.libs.binding", "shared" },
  { "arm-Other-gcc.output", "it0044-targets-1.0-SNAPSHOT" },
  { "nar.shared", coordinate + "${aol}-shared" },
  { "nar.static", coordinate + "${aol}-static" },
};
for (int i = 0; i < expected.length; i++) {
  String value = main.getProperty(expected[i][0]);
  if (!expected[i][1].equals(value)) {
    throw new RuntimeException(expected[i][0] + " is " + value + ", expected " + expected[i][1] + ": " + main);
  }
}

String log = new String(java.nio.file.Files.readAllBytes(new File(basedir, "build.log").toPath()));
if (log.indexOf("-shared NAR built here isn't declared in targets") < 0) {
  throw new RuntimeException("The host's undeclared NAR wasn't reported");
}
return true;
