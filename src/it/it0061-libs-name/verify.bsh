import java.io.File;
import java.io.FileInputStream;
import java.util.Properties;

String prefix = "it0061-libs-name-1.0-SNAPSHOT-";
File[] dirs = new File(basedir, "target/nar").listFiles();
int described = 0;
for (int i = 0; i < dirs.length; i++) {
  String name = dirs[i].getName();
  if (!dirs[i].isDirectory() || !name.startsWith(prefix) || !name.endsWith("-shared")) {
    continue;
  }
  String aol = name.substring(prefix.length(), name.length() - "-shared".length());
  Properties descriptor = new Properties();
  descriptor.load(new FileInputStream(new File(dirs[i],
      "META-INF/nar/com.github.maven-nar.its.nar/it0061-libs-name/" + aol + "-shared.properties")));
  // as the linker finds the library: without the prefix, except for a GNU
  // linker on Windows, which also finds the library by its full name
  boolean windowsGnu = aol.indexOf("-Windows-") >= 0 && !aol.endsWith("-msvc");
  String expected = (windowsGnu ? "lib" : "") + "it0061-libs-name-1.0-SNAPSHOT stale";
  if (!expected.equals(descriptor.getProperty("libs.names"))) {
    throw new RuntimeException("libs.names is " + descriptor.getProperty("libs.names") + ", expected " + expected);
  }
  described++;
}
if (described != 1) {
  throw new RuntimeException("Expected one shared NAR, found " + described);
}

String log = new String(java.nio.file.Files.readAllBytes(new File(basedir, "build.log").toPath()));
if (log.indexOf("libs.names stale isn't among the libraries packaged") < 0) {
  throw new RuntimeException("The stale name wasn't warned about");
}
return true;
